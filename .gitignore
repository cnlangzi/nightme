# Binaries
/bin/
/dist/
/nightme
*.exe
*.exe~
*.dll
*.so
*.dylib

# Windows resource objects (regenerated on demand by `make winres`
# / build.bat from winres.json + cmd/nightme/logo.ico + manifest.xml).
# Git-ignored because they are build artifacts, not source — keeping
# them out of the tree lets `logo.ico` / `winres.json` / `manifest.xml`
# stay the single source of truth.
/cmd/nightme/rsrc_windows_*.syso

# Test artifacts
*.test
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories
vendor/
.serena/

# Go workspace
go.work
go.work.sum

# Local Go build cache (sandbox workaround; never committed)
.cache/


.claude/worktrees/

# Environment
.env

# Working notes (untracked; drafts for future PRs go here)
wip/
.env.*

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Runtime registry / session state
registry.json
sessions.json
data/

# Local task notes (developer-only — never tracked)
# Used for in-flight design notes, handoff docs, post-mortems.
# Lives on each dev's machine; not part of the project source.
tasks/
# Claude local config
.claude/
.codegraph/
graphify-out/

# tokensave local index
.tokensave/

# Task scratch / design notes (not part of repo)
# /tasks/ holds WIP design docs and implementation plans;
# treated as ephemeral working notes (not tracked in git).
/tasks/
.nightme/
